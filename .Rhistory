# If using simple base map:
library(maps)
states <- map_data("state")
ggplot() +
geom_polygon(data = states, aes(x = long, y = lat, group = group),
fill = "gray95", color = "white") +
geom_point(data = pm25_data, aes(x = Longitude, y = Latitude, color = predicted),
size = 1.5, alpha = 0.8) +
scale_color_viridis_c(option = "magma") +
coord_fixed(1.3) +
labs(
title = "Predicted PM2.5 by Monitoring Site",
x = "Longitude", y = "Latitude", color = "Predicted"
) +
theme_minimal()
# Load required packages
library(ggplot2)
library(viridis)
library(maps)
# Load U.S. state map data
states <- map_data("state")
# Make sure you're using filtered PM2.5 data and predicted values:
# (Assuming you've already created pm25_data and predicted column)
# Plot with background map
ggplot() +
# Background state map
geom_polygon(data = states, aes(x = long, y = lat, group = group),
fill = "gray95", color = "white", linewidth = 0.3) +
# Overlay predicted PM2.5 points
geom_point(data = pm25_data, aes(x = Longitude, y = Latitude, color = predicted),
size = 1.4, alpha = 0.8) +
# Color scale for predicted values
scale_color_viridis_c(
option = "plasma",
name = expression(paste("Predicted ", PM[2.5], " (", mu, "g/m"^3, ")")),
guide = guide_colorbar(barwidth = 10, barheight = 1)
) +
# Map coordinate aspect ratio
coord_fixed(1.3) +
# Titles and theme
labs(
title = expression("Predicted " ~ PM[2.5] ~ " Concentrations Across the U.S."),
subtitle = "Model-based estimates by monitoring site (Annual Average)",
x = "Longitude", y = "Latitude"
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(face = "bold"),
legend.position = "bottom",
panel.grid = element_blank()
)
library(leaflet)
library(viridis)
# Optional: scale predicted values for color
pal <- colorNumeric(
palette = "plasma",
domain = pm25_data$predicted
)
# Create leaflet map
leaflet(pm25_data) %>%
addProviderTiles(providers$CartoDB.Positron) %>%  # clean background map
addCircleMarkers(
lng = ~Longitude,
lat = ~Latitude,
radius = 3,
color = ~pal(predicted),
stroke = FALSE,
fillOpacity = 0.8,
label = ~paste0("Predicted PM2.5: ", round(predicted, 2), " µg/m³")
) %>%
addLegend(
"bottomright",
pal = pal,
values = ~predicted,
title = "Predicted PM2.5 (µg/m³)",
opacity = 1
)
names(data)
