library(plotly)
library(viridis)
plot_3d <- plot_ly(
data = ridge_data,
x = ~Year,
y = ~`1st Max Value`,
z = ~`Arithmetic Mean`,
color = ~`Observation Percent`,
colors = viridis(256),
type = "scatter3d",
mode = "markers",
opacity = 0.6,
marker = list(size = 3)
) %>%
layout(
title = list(text = "3D PM2.5 Trends by Year and Max Value"),
scene = list(
xaxis = list(title = "Year"),
yaxis = list(title = "1st Max Value"),
zaxis = list(title = "Arithmetic Mean")
)
)
