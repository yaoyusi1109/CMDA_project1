x = ~Year,
y = ~`1st Max Value`,
z = ~`Arithmetic Mean`,
color = ~`Observation Percent`,
colors = viridis(256),
type = "scatter3d",
mode = "markers",
size = 0.5,
opacity = 0.6,
scene = list(xaxis = list(title = "Year"),
yaxis = list(title = "1st Max Value"),
zaxis = list(title = "Arithmetic Mean"))) %>%
layout(title = "3D PM2.5 Trends by Year and Max Value")
