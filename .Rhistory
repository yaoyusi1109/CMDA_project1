library(readr)
annual_conc_by_monitor_2024 <- read_csv("data/annual_conc_by_monitor_2024.csv")
View(annual_conc_by_monitor_2024)
library(flexdashboard)
# Install thematic and un-comment for themed static plots (i.e., ggplot2)
# thematic::thematic_rmd()
library(readr)
data <- read_csv("data/annual_conc_by_monitor_2024.csv")
library(readr)
data <- read_csv("data/annual_conc_by_monitor_2024.csv")
names(data)
# Load necessary packages
library(dplyr)
library(ggplot2)
library(broom)
# Filter to only PM2.5 observations (optional, depending on your data)
pm25_data <- data %>%
filter(`Parameter Name` == "PM2.5 - Local Conditions") %>%
select(`Arithmetic Mean`, Latitude, Longitude, Year,
`Observation Count`, `1st Max Value`,
`90th Percentile`, `10th Percentile`) %>%
na.omit()
# Fit multiple linear regression model
lm_model <- lm(`Arithmetic Mean` ~ Latitude + Longitude + Year +
`Observation Count` + `1st Max Value` +
`90th Percentile` + `10th Percentile`,
data = pm25_data)
# Print model summary
summary(lm_model)
# Optional: View tidy results
tidy(lm_model)
# Diagnostic plots
par(mfrow = c(2, 2))
plot(lm_model)
# Add fitted values and residuals
pm25_data$predicted <- predict(lm_model)
pm25_data$residuals <- resid(lm_model)
# Plot: Actual vs Predicted
ggplot(pm25_data, aes(x = `Arithmetic Mean`, y = predicted)) +
geom_point(alpha = 0.3, color = "steelblue") +
geom_abline(slope = 1, intercept = 0, color = "red", linetype = "dashed") +
labs(title = "Actual vs Predicted PM2.5", x = "Actual", y = "Predicted") +
theme_minimal()
ggplot(pm25_data, aes(x = predicted, y = residuals)) +
geom_point(alpha = 0.3, color = "darkorange") +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(title = "Residuals vs Fitted", x = "Predicted", y = "Residuals") +
theme_minimal()
library(broom)
coef_df <- tidy(lm_model) %>%
filter(!is.na(estimate))
ggplot(coef_df, aes(x = reorder(term, estimate), y = estimate)) +
geom_col(fill = "skyblue") +
coord_flip() +
labs(title = "Linear Regression Coefficients",
x = "Predictor", y = "Estimate") +
theme_minimal()
ggplot(pm25_data, aes(x = Longitude, y = Latitude, color = predicted)) +
geom_point(size = 1, alpha = 0.6) +
scale_color_viridis_c() +
labs(title = "Predicted PM2.5 by Location",
x = "Longitude", y = "Latitude", color = "Predicted") +
theme_minimal()
library(ggplot2)
library(viridis)
library(scales)
# Improved spatial plot
ggplot(pm25_data, aes(x = Longitude, y = Latitude, color = predicted)) +
geom_point(size = 1.2, alpha = 0.8) +
scale_color_viridis_c(
option = "plasma",
name = expression(paste("Predicted ", PM[2.5], " (", mu, "g/m"^3, ")")),
guide = guide_colorbar(barwidth = 10, barheight = 1)
) +
coord_fixed(1.3) +  # Fix aspect ratio to look like a map
theme_minimal(base_size = 13) +
labs(
title = expression("Geospatial Distribution of Predicted " ~ PM[2.5]),
subtitle = "Model-predicted average annual concentration by monitor location",
x = "Longitude", y = "Latitude"
) +
theme(
plot.title = element_text(face = "bold"),
legend.position = "bottom",
panel.grid = element_blank()
)
